# Weir server settings for local development — copy this file to ``.env`` at the repository root.
# The server (apps/server) reads WEIR_* from its environment only; the dev launchers
# (scripts/dev-backend.ps1, scripts/dev.ps1, ``npm run dev`` in apps/web) load this ``.env`` into that
# environment first, and a variable already set in your shell wins. Never commit real ``.env`` files.
# See ADR-0002 (database) and ADR-0003 (auth).
#
# Product-owned data root (not an implicit “use the Git checkout” path; not cwd). Unset defaults:
#   Windows: %PROGRAMDATA%\Weir (normally C:\ProgramData\Weir)
#   Linux/macOS: $XDG_DATA_HOME/weir or ~/.local/share/weir
# Future logs/cache/files should live under this tree.
# WEIR_HOME=C:\ProgramData\Weir

# development | production
WEIR_ENV=development

# SQLite file (optional). Relative paths are resolved under WEIR_HOME. Default: data/weir.sqlite3
# WEIR_DB_PATH=data/weir.sqlite3
# How long a write waits for the database (Weir's own writers, then any program outside Weir that
# holds it, such as a backup tool) before it answers 503 with Retry-After. 1 to 120 seconds. Default 30.
# WEIR_SQLITE_BUSY_TIMEOUT_SECONDS=30

# Optional directory overrides (relative segments allowed under WEIR_HOME)
# WEIR_BACKUP_DIR=backups
# WEIR_LOG_DIR=logs
# WEIR_TEMP_DIR=temp

WEIR_LOG_LEVEL=INFO

# CORS for the API. When set, also used for trusted Origin/Referer on POST /api/v1/auth/*
# unless WEIR_TRUSTED_BROWSER_ORIGINS overrides that list.
# In WEIR_ENV=development, each http(s)://127.0.0.1:<port> entry also trusts localhost:<port>
# (and vice versa) so either URL works in the browser.
# WEIR_CORS_ORIGINS=http://127.0.0.1:8782
# WEIR_TRUSTED_BROWSER_ORIGINS=
# Reverse proxy client IP trust. Only set this to the immediate trusted proxy IP/CIDR.
# Weir ignores X-Forwarded-For unless this is configured.
# WEIR_TRUSTED_PROXY_IPS=

# Extra Host header values Weir accepts, beyond IP literals, localhost, single-label and
# local-network names, and the CORS/trusted-browser origins above. A reverse-proxy domain needs
# an entry here; a leading "*." also allows its subdomains.
# WEIR_ALLOWED_HOSTS=

# Media-manager webhook secret — set to a long random string, then configure the same value as a
# custom header (X-Webhook-Secret) in your media manager's webhook settings. Without this, the
# intake endpoint accepts unauthenticated requests from any caller on your network. A per-connection
# secret set under Setup › Connections › Media managers takes precedence over this instance-wide fallback.
# Formerly WEIR_SUBBER_WEBHOOK_SECRET, which is still read for installs that set it.
# WEIR_MEDIA_MANAGER_WEBHOOK_SECRET=replace-with-long-random-value
# Weir sets up its workflows from a media manager that reports its folders (Deluno) and keeps their watched and output
# folders in step with it. 0 leaves every workflow's folders to be typed in Weir. Default 1.
# WEIR_MEDIA_MANAGER_WORKFLOW_SYNC_ENABLED=1

# In-process rate limits (single Weir application process only; see docs/deployment-model.md)
# WEIR_AUTH_LOGIN_RATE_MAX_ATTEMPTS=10
# WEIR_AUTH_LOGIN_RATE_WINDOW_SECONDS=60
# WEIR_BOOTSTRAP_RATE_MAX_ATTEMPTS=10
# WEIR_BOOTSTRAP_RATE_WINDOW_SECONDS=3600

# HSTS: only when this app is always reached over HTTPS (defaults off)
# WEIR_SECURITY_ENABLE_HSTS=0
# Optional bearer token for machine scrapes of GET /metrics (for example Prometheus).
# Browser operators can still use their normal admin/operator session cookie.
# WEIR_METRICS_BEARER_TOKEN=replace-with-long-random-value

# Required for GET /api/v1/auth/csrf and signed CSRF tokens (login/logout)
# WEIR_SESSION_SECRET=replace-with-long-random-value
#
# Recommended for stored Weir credentials (Sonarr/Radarr keys).
# If unset, Weir can still read legacy credentials with WEIR_SESSION_SECRET, but rotating
# WEIR_SESSION_SECRET will require re-entering any credentials still encrypted with the old session secret.
# WEIR_CREDENTIALS_SECRET=replace-with-a-different-long-random-value
#
# During credential-secret rotation, set WEIR_CREDENTIALS_SECRET to the new value and keep the old value here
# until saved Sonarr/Radarr credentials have been re-saved or migrated.
# WEIR_PREVIOUS_CREDENTIALS_SECRETS=old-credentials-secret

# Optional session cookie (defaults shown)
# WEIR_SESSION_COOKIE_NAME=weir_session
# WEIR_SESSION_COOKIE_SECURE=0
# WEIR_SESSION_COOKIE_SAMESITE=lax
# WEIR_SESSION_IDLE_MINUTES=720
# WEIR_SESSION_ABSOLUTE_DAYS=14

# Processing — internal worker slots for ``jobs`` only (default 10 slots available, the most "Files at once" can be).
# User-facing concurrency is controlled in the app: Setup › Performance › Speed › Files at once (1 to 10).
# Leave this unset unless you need an emergency startup cap or want to disable Processing workers completely with 0.
# WEIR_PROCESSING_WORKER_COUNT=10
# Processing ``processing.file.remux_pass.v1`` uses each Processing library's saved folders (/api/v1/processing/libraries), not this env.
# Legacy only (still read; not used for remux path resolution once path settings exist).
# WEIR_PROCESSING_REMUX_MEDIA_ROOT=
# Processing — supplied payload evaluation was REMOVED in #339, along with its legacy
# ``WEIR_PROCESSING_LIBRARY_AUDIT_PASS_SCHEDULE_*`` compatibility. On a schedule it was
# enqueued with no payload, so it evaluated zero rows and wrote the same constant once
# per interval forever. Its job-kind prefix is retired, so a row left by an older install
# is still refused rather than quietly accepted.
#
# Processing — the candidate gate was RESHAPED in #339 from a queued job family into a
# synchronous endpoint, ``GET /api/v1/processing/files/{id}/why-held``. It is a read-only
# question whose answer the caller wants immediately, so it no longer goes through the
# queue. Its prefix is retired too.

# Processing — Pass 3a Movies output-folder cleanup (minimum age before deleting a per-title folder under the Movies output root after a successful Movies remux; Radarr library paths checked live). 1h..30d; default 48h.
# WEIR_PROCESSING_MOVIE_OUTPUT_CLEANUP_MIN_AGE_SECONDS=172800

# Processing — Pass 3b TV output-folder cleanup (minimum age on direct-child episode media before deleting a season folder under the TV output root after a successful TV remux; Sonarr episode file paths checked live). 1h..30d; default 48h.
# WEIR_PROCESSING_TV_OUTPUT_CLEANUP_MIN_AGE_SECONDS=172800

# Processing — watched-folder remux scan dispatch (``processing.watched_folder.remux_scan_dispatch.v1``) periodic enqueue.
# Whether each scope is scanned, and how often, lives on each workflow in Setup › Workflows (in the
# database, no restart needed) — there is no environment variable for it.
# Whether those periodic ticks may also queue file work is set here. Default is 1 (they do). Restart the server after changes:
# WEIR_PROCESSING_WATCHED_FOLDER_REMUX_SCAN_DISPATCH_PERIODIC_ENQUEUE_REMUX_JOBS=1

# Processing — filesystem watcher. Not ported to the .NET server yet: it reads these settings but only the
# periodic scan finds new files today. Events are meant to be the trigger; the periodic scan above is the backstop and always
# runs, so switching this off makes Weir slower to notice a new file, never blind to it. A watcher that
# cannot start (Docker bind mounts, SMB and NFS often deliver no events) falls back to the scan on its own,
# says so once in the log, and reports itself on /readiness. Per-workflow opt-out is in Setup › Workflows.
# WEIR_PROCESSING_WATCHER_ENABLED=1
# How long a watched tree must be quiet before a burst of writes becomes one scan. 1..300s; default 3.
# WEIR_PROCESSING_WATCHER_DEBOUNCE_SECONDS=3

# Processing — work/temp stale sweep (``processing.work_temp_stale_sweep.v1``) periodic enqueue — **per media type** (Movies vs TV).
# Whether the work/temp stale sweep runs is a **setting** in Setup › Performance › Cleanup and over the API — it used
# to be enabled only by these variables, with no UI, so a default install never reclaimed its own stale work files (#339).
# These variables survive as kill switches: an explicit 0 turns off the timer for the media type in its name, and only that
# one, whatever is saved. They can no longer switch a family *on*. The old shared WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_SCHEDULE_*
# pair is retired and ignored.
# WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_MOVIE_SCHEDULE_ENABLED=0
# WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_MOVIE_SCHEDULE_INTERVAL_SECONDS=3600
# WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_TV_SCHEDULE_ENABLED=0
# WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_TV_SCHEDULE_INTERVAL_SECONDS=3600
# Minimum age (seconds) before a Processing temp file may be deleted — **shared** for both media types (same temp filename rule; 60 .. 30d; default 86400).
# It also decides how long a failed copy kept by Setup › Performance › Cleanup › "Keep a failed file's half-written copy for a day" lasts, at a restart as well as in the sweep.
# WEIR_PROCESSING_WORK_TEMP_STALE_SWEEP_MIN_STALE_AGE_SECONDS=86400

# Retired and ignored: the failed-download cleanup (Cleanup -> "Downloads of failed files") is gone. A failed download is handled by
# History's remove dialog and by the workflow's "When retries run out". These variables are still accepted, so an existing
# environment file keeps working, and change nothing:
# WEIR_PROCESSING_MOVIE_FAILURE_CLEANUP_SCHEDULE_ENABLED
# WEIR_PROCESSING_MOVIE_FAILURE_CLEANUP_SCHEDULE_INTERVAL_SECONDS
# WEIR_PROCESSING_TV_FAILURE_CLEANUP_SCHEDULE_ENABLED
# WEIR_PROCESSING_TV_FAILURE_CLEANUP_SCHEDULE_INTERVAL_SECONDS
# WEIR_PROCESSING_MOVIE_FAILURE_CLEANUP_GRACE_PERIOD_SECONDS
# WEIR_PROCESSING_TV_FAILURE_CLEANUP_GRACE_PERIOD_SECONDS

# Job-row retention: automatically delete terminal job rows (completed/failed/cancelled) after N days (1..365; default 7).
# WEIR_JOB_ROWS_RETENTION_DAYS=7
# How often (seconds, 60..86400) the job-row retention task runs (default 3600).
# WEIR_JOB_ROWS_RETENTION_SCHEDULE_INTERVAL_SECONDS=3600

# Posters and the original language of each title come from Deluno's metadata service, which needs no key. They are always on and
# there is no setting for them. This is the service's address (the default is Deluno's own); set it to off to ask no one, which
# shows no posters and leaves the language preferences to choose audio.
# WEIR_ARTWORK_GATEWAY_URL=https://deluno-metadata-gateway.ejmdigital.workers.dev

# Shared *arr HTTP fallback credentials (used when no media manager connection supplies them).
# WEIR_ARR_RADARR_BASE_URL=http://127.0.0.1:7878
# WEIR_ARR_RADARR_API_KEY=
# WEIR_ARR_SONARR_BASE_URL=http://127.0.0.1:8989
# WEIR_ARR_SONARR_API_KEY=


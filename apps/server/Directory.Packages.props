<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <!-- IANA time zone names on Windows, where InvariantGlobalization leaves no ICU to map them. -->
    <PackageVersion Include="TimeZoneConverter" Version="7.2.0" />
    <!-- Browser automation for the end-to-end tests and the packaged live audit -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Property-based tests: the inputs are generated, with a fixed seed so every run is the same (PropertyChecks). -->
    <PackageVersion Include="FsCheck" Version="3.4.0" />
  </ItemGroup>
</Project>

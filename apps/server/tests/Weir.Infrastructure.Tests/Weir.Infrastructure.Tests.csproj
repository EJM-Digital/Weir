<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The coverage collector reads the ASP.NET Core assemblies Weir.Infrastructure uses from the compilation context; without it the collector cannot open Weir.Infrastructure and measures nothing for it. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Weir.Infrastructure\Weir.Infrastructure.csproj" />
    <!-- The slow-tool stand-in the process runner tests start; its apphost is copied next to the test assembly. -->
    <ProjectReference Include="..\Weir.TestChild\Weir.TestChild.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The property-test runner and its path generators, compiled into each test project that has property tests. -->
    <Compile Include="..\Weir.Core.Tests\TestSupport\PropertyChecks.cs" Link="TestSupport\PropertyChecks.cs" />
    <Compile Include="..\Weir.Core.Tests\TestSupport\PathGenerators.cs" Link="TestSupport\PathGenerators.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every way Weir can change a media file and what holds it back while paused (docs/coverage/file-changing-paths.json). -->
    <Compile Include="..\Shared\FileChangingPathsTable.cs" Link="TestSupport\FileChangingPathsTable.cs" />
    <!-- Recordings of a real Sonarr and Radarr (fixtures/recorded) and the handler that replays them. -->
    <Compile Include="..\Shared\ArrRecordings.cs" Link="TestSupport\ArrRecordings.cs" />
    <!-- GitHub, as it answered when recorded (fixtures/recorded/github-releases). -->
    <Compile Include="..\Shared\RecordedGitHub.cs" Link="TestSupport\RecordedGitHub.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- A configuration bundle exported by an older release (format version 4): a frozen compatibility fixture. -->
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The ffmpeg layer's golden fixtures, shared with Weir.Core.Tests (checked-in .NET fixtures; see apps/server/README.md). -->
    <None Include="../Weir.Core.Tests/Media/golden/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Media/golden" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Weir.Core\Weir.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Values in formats earlier releases wrote (argon2 password hashes, itsdangerous-signed tokens, Fernet-encrypted values): frozen compatibility fixtures. -->
    <None Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recordings of a real Sonarr and Radarr (fixtures/recorded) and the handler that replays them. -->
    <Compile Include="..\Shared\ArrRecordings.cs" Link="TestSupport\ArrRecordings.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Answers first recorded from the rules engine's earlier releases; now maintained as .NET fixtures (apps/server/README.md). -->
    <None Include="Rules/golden/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Rules/golden" />
    <!-- Issue #537: golden cases whose correct answer now deliberately differs from the one an earlier release recorded. See GoldenParityTests for the mechanism. -->
    <None Include="Rules/golden/overrides/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Rules/golden/overrides" />
    <!-- Answers first recorded from the ffmpeg layer's earlier releases; now maintained as .NET fixtures (apps/server/README.md). -->
    <None Include="Media/golden/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="Media/golden" />
  </ItemGroup>
</Project>

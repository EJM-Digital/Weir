<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQLite, filesystem, logging sinks, processes and HTTP clients. -->
  <PropertyGroup>
    <RootNamespace>Weir.Infrastructure</RootNamespace>
    <!-- LibraryImport marshalling for GetFinalPathNameByHandle (folder browsing on Windows). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Weir.Core\Weir.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Saves the stacks of every thread when the server is slow to get to work (StallDumpCapture); no tool is installed beside Weir. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="Weir.Infrastructure.Migrations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Processing\DirectPlay\devices.json" LogicalName="Weir.Infrastructure.Processing.DirectPlay.devices.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Weir.Infrastructure.Tests" />
  </ItemGroup>
</Project>

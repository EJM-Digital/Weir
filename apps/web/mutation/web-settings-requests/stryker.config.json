{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-core.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run src/lib/settings"
  },
  "mutate": [
    "src/lib/settings/settings-api.ts"
  ],
  "coverageAnalysis": "off",
  "tempDirName": "../../.stryker-tmp",
  "concurrency": 2,
  "timeoutFactor": 3,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 30,
  "reporters": [
    "clear-text",
    "progress",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/web-settings-requests/mutation-report.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/web-settings-requests/mutation-report.html"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  What the tray's coverage figure counts (#976): the tray itself, whose assembly is named Weir, and nothing else.
  The test project and the stand-in server the install tests start are left out, and so is anything the
  compiler generated, so the figure moves only when a test does or a line of tray code does.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Weir]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

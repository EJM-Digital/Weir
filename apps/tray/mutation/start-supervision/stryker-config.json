{
  "stryker-config": {
    "project": "Weir.Tray.csproj",
    "mutate": [
      "**/ServerHost.cs",
      "**/ServerHost.Supervision.cs",
      "**/StartWatch.cs",
      "**/StartProgress.cs",
      "**/StartProgressFeed.cs"
    ],
    "ignore-methods": [
      "*ConfigureAwait",
      "*ThrowIfNull",
      "*ThrowIfNullOrEmpty"
    ],
    "coverage-analysis": "perTest",
    "reporters": [
      "json",
      "html",
      "dots"
    ],
    "concurrency": 4
  }
}

# Local-only working files (never commit)
.local/
.local-dev-home/
.local-dev-home*/
.tmp/

# Evidence and captures written by CI and scripts (live audits, contract server logs, screenshots)
artifacts/

# Local scratch (screenshots, one-off captures, ad-hoc Playwright installs)
tmp/
scripts/node_modules/

# Build-time downloaded Windows FFmpeg runtime
packaging/windows/vendor/

# Claude Code local settings and agent worktrees (machine-specific, never commit)
.claude/settings.local.json
.claude/worktrees/

# .NET build output and test results. build-velopack.ps1 publishes from source into dist/.
apps/tray/*/bin/
apps/tray/*/obj/
apps/server/**/bin/
apps/server/**/obj/
apps/server/**/TestResults/
TestResults/
*.trx
apps/server/artifacts/

# Docusaurus
docs-site/build/
docs-site/.docusaurus/

# Scratch WEIR_CONTRACT_LEDGER files from local contract-suite runs
.contract-ledger/

# Contract-suite leftover-server ledgers (WEIR_CONTRACT_LEDGER), per worktree.
.ledger*.json

# PID of the dev API process this worktree's `npm run dev` spawned (scripts/stop-dev-api-port.mjs
# reads it to stop only that process, never "whatever holds the port" — see run-api-dev.mjs).
.dev-api.pid

# The TypeScript incremental build cache.
*.tsbuildinfo

# Secrets and key material (never commit): certificates, private keys, data-protection key rings,
# credential files, and SQLite files with their write-ahead companions.
*.key
*.pem
*.pfx
*.p12
*.snk
secrets.json
*credentials*.json
DataProtection-Keys/
data-protection-keys/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm

# Web app coverage report (npm run test:coverage)
apps/web/coverage/
